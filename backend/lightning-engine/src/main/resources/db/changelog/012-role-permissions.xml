<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Collegamento many-to-many ruolo <-> permesso, necessario per la
      console di amministrazione (RolePermissionRepository): quali
      permessi ha ogni ruolo, per decidere sia l'accesso a /admin sia la
      voce di menu "Amministrazione". Non esisteva ancora su Postgres -
      lo schema equivalente (system_role_permissions) era stato
      progettato solo per ClickHouse nella migrazione Flyway V1.
    -->
    <changeSet id="25" author="lightningbi">
        <createTable tableName="pg_lbi_system_role_permissions">
            <column name="role_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="permission_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey
                tableName="pg_lbi_system_role_permissions"
                columnNames="role_id, permission_id"/>
    </changeSet>

</databaseChangeLog>
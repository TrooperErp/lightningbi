<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="022-area-source-connection" author="lightningbi">
        <!-- Le sorgenti esistenti hanno le credenziali dentro il JSON di
             config e non hanno una connessione a cui puntare: la colonna è
             obbligatoria, quindi la migrazione si ferma se la tabella non è
             vuota (i dataset vanno eliminati prima). -->
        <preConditions onFail="HALT" onFailMessage="lbi_area_source non è vuota: elimina prima i dataset esistenti">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM lbi_area_source</sqlCheck>
        </preConditions>

        <addColumn tableName="lbi_area_source">
            <column name="connection_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_area_source_connection"
                             references="lbi_connection(id)"/>
            </column>
        </addColumn>

        <createIndex indexName="idx_area_source_connection" tableName="lbi_area_source">
            <column name="connection_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
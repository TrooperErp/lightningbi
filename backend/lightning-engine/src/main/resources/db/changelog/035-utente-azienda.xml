<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="035-utente-azienda" author="lightningbi">
        <!-- Azienda (ditta) dell'utente: section access. Vuota = vede tutte le aziende (admin). -->
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="pg_lbi_system_users" columnName="codice_ditta_assegnata"/>
            </not>
        </preConditions>
        <addColumn tableName="pg_lbi_system_users">
            <column name="codice_ditta_assegnata" type="integer"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
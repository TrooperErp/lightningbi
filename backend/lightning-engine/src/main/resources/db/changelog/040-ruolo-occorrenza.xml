<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Ruolo della tabella in un dataset: NULL = quello predefinito della tabella importata. -->
    <changeSet id="040-ruolo-occorrenza" author="lightningbi">
        <sql>
            ALTER TABLE lbi_area_imported_table
                ADD COLUMN ruolo VARCHAR(20) NULL
                CONSTRAINT ck_area_tabella_ruolo CHECK (ruolo IS NULL OR ruolo IN ('FATTI', 'DIMENSIONE'));
        </sql>
    </changeSet>

</databaseChangeLog>